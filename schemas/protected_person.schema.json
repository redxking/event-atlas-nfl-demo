{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-case protected professional record (local only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","scopeId","displayName","role","professionalRole","designationSource","identityConfidence","identityRationale","publicProfessionalFacts","retentionUntil","dissemination","status","createdBy","createdAt"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "displayName": {"type":"string","minLength":1},
    "scopeId": {"type":"string","minLength":1},
    "role": {"enum":["team_official","player","coach","league_official","elected_official","performer","other_designated"]},
    "professionalRole": {"type":"string","minLength":3},
    "designationSource": {"type":"object","additionalProperties":false,"required":["url","authority","observedAt"],"properties":{"url":{"type":"string","format":"uri","pattern":"^https://"},"authority":{"type":"string"},"observedAt":{"type":"string","format":"date-time"}}},
    "identityConfidence": {"enum":["low","moderate","high"]},
    "identityRationale": {"type":"string","minLength":20},
    "publicProfessionalFacts": {"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["claim","sourceUrl","observedAt"],"properties":{"claim":{"type":"string"},"sourceUrl":{"type":"string","format":"uri","pattern":"^https://"},"observedAt":{"type":"string","format":"date-time"}}}},
    "retentionUntil": {"type":"string","format":"date-time"},
    "dissemination": {"const":"internal_only"},
    "status": {"enum":["pending_review","approved","rejected"]},
    "createdBy": {"type":"string"},
    "createdAt": {"type":"string","format":"date-time"}
  }
}
